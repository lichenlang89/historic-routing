     # {'router bgp 65001': {'PG': ['10.1.1.2'], 'PG1': ['10.1.1.21']},
     #  'router bgp 65001 vrf vrf1': {'PG': ['10.1.1.2'], 'PG1': ['10.1.1.21']}}
@@ -2977,6 +2979,50 @@
         if not exec_delete_lines(vtysh, rundir, unread):
             exec_success = False
     return exec_success
+
+
+def egp_entries(config, prefix):
+    return [(keys, None) for keys in config.contexts
+            if len(keys) == 1 and keys[0].startswith(prefix)]
+
+
+def order_egp_reload(newconf, running, adds, deletes):
+    # A global change requires a deliberate adjacency rebuild. Even unchanged
+    # neighbors must be removed, then restored from the target configuration.
+    if any(len(keys) == 1 and keys[0].startswith(("egp local-as ", "egp timers "))
+           for keys, line in adds + deletes):
+        for entry in egp_entries(running, "egp neighbor "):
+            if entry not in deletes:
+                deletes.append(entry)
+        for entry in egp_entries(newconf, "egp neighbor "):
+            if entry not in adds:
+                adds.append(entry)
+    # Preserve non-EGP ordering. EGP globals precede neighbor additions even
+    # when an operator writes the target file in a different order.
+    egp_adds = [entry for entry in adds if entry[0][0].startswith("egp ")]
+    adds = [entry for entry in adds if not entry[0][0].startswith("egp ")]
+    adds.extend(sorted(egp_adds, key=lambda e: e[0][0].startswith("egp neighbor ")))
+    return adds, deletes
+
+
+def delete_egp_neighbors(vtysh, rundir, deletes):
+    neighbors = [entry for entry in deletes
+                 if len(entry[0]) == 1 and entry[0][0].startswith("egp neighbor ")]
+    if not neighbors:
+        return deletes
+    if not exec_delete_lines(vtysh, rundir, neighbors):
+        raise VtyshException("EGP neighbor deletion failed; globals were not changed")
+    addresses = {entry[0][0].split()[2] for entry in neighbors}
+    # no neighbor starts RFC 904 Cease; it is not a synchronous close. Wait
+    # for a matching ack or the daemon's 120-second abort before changing AS.
+    deadline = time.monotonic() + 125
+    while True:
+        state = json.loads(vtysh("show ip egp neighbors json"))
+        if not addresses.intersection(peer["address"] for peer in state["peers"]):
+            return [entry for entry in deletes if entry not in neighbors]
+        if time.monotonic() >= deadline:
+            raise VtyshException("Timed out waiting for EGP Cease cleanup; retry reload")
+        time.sleep(0.2)


