# historic-routing / EGP 实验参数
#
# 用法：cp lab.env.example lab.env，按需修改 lab.env 后再跑 lab.sh。
#      lab.sh 优先读 lab.env，没有则读 lab.env.example（全部是可用的默认值）。
# 注意：lab.env 已在 .gitignore 中，不要把个人路径、凭据、私有 IP 写进仓库。

# ---------- 镜像 ----------
# 实验镜像（本地构建，不依赖任何私有仓库）
LAB_IMAGE=${LAB_IMAGE:-localhost/historic-routing-lab:egp}
# 公开基础镜像（构建镜像时用）
LAB_BASE_IMAGE=${LAB_BASE_IMAGE:-quay.io/centos/centos:stream10}
# Containerfile 路径（相对 lab/egp）
LAB_CONTAINERFILE=${LAB_CONTAINERFILE:-Containerfile}

# ---------- FRR 安装前缀（S4 的 make install 产物） ----------
# 必须与 zebra/vtysh/libfrr 来自同一次构建
LAB_PREFIX=${LAB_PREFIX:-/opt/historic-routing/egp-27f287be9}
# 容器内固定挂载点（与 Containerfile 的 ENV LAB_MOUNT 一致，不要随意改）
LAB_MOUNT=${LAB_MOUNT:-/build/prefix}

# ---------- 本实验独占的资源名（清理只允许作用于这些） ----------
LAB_NET=${LAB_NET:-egp-lab-net}
LAB_SUBNET=${LAB_SUBNET:-198.18.123.0/24}
LAB_NAME_PREFIX=${LAB_NAME_PREFIX:-egp-lab-r}
# 容器在实验网段上的地址（有类网络内的主机地址）
LAB_IP1=${LAB_IP1:-198.18.123.1}
LAB_IP2=${LAB_IP2:-198.18.123.2}

# ---------- EGP 参数 ----------
LAB_AS1=${LAB_AS1:-65001}
LAB_AS2=${LAB_AS2:-65002}
LAB_TIMERS=${LAB_TIMERS:-"2 6"}
# 各自宣告的有类网络 + stub 接口地址
LAB_NET1=${LAB_NET1:-10.0.0.0}
LAB_HOST1=${LAB_HOST1:-10.0.0.1/8}
LAB_NET2=${LAB_NET2:-172.16.0.0}
LAB_HOST2=${LAB_HOST2:-172.16.0.1/16}
# 数据面测试用的 UDP 端口
LAB_UDP_PORT=${LAB_UDP_PORT:-9999}

# ---------- 宿主机运行目录（日志、pid、测试报告） ----------
LAB_RUNDIR=${LAB_RUNDIR:-/var/tmp/egp-lab}
