# /usr/lib/systemd/system/historic-routing-egpd.service
[Unit]
# SPDX-License-Identifier: GPL-2.0-or-later
# historic-routing 的 EGP daemon（实验性 RFC 904 stub gateway，开发验证构建）。
# 依赖同一次构建的 historic-routing-zebra（通过 ZAPI 下发路由）。
Description=historic-routing EGP daemon (experimental, non-production)
Documentation=https://github.com/lichenlang89/historic-routing
After=network.target historic-routing-zebra.service
Wants=historic-routing-zebra.service
ConditionPathExists=/opt/historic-routing/27f287be9/sbin/egpd

[Service]
Type=simple
RuntimeDirectory=historic-routing/frr
RuntimeDirectoryMode=0755
ExecStart=/opt/historic-routing/27f287be9/sbin/egpd \
	-f /opt/historic-routing/27f287be9/etc/frr/egpd.conf \
	-i /run/historic-routing/frr/egpd.pid \
	-z /run/historic-routing/frr/zserv.api \
	--vty_socket /run/historic-routing/frr \
	-u root -g root
ExecReload=/opt/historic-routing/27f287be9/sbin/frr-reload.py --reload --daemon egpd \
	--bindir /opt/historic-routing/27f287be9/bin --confdir /opt/historic-routing/27f287be9/etc/frr \
	--logfile /run/historic-routing/frr/egpd-reload.log \
	--rundir /run/historic-routing/frr --vty_socket /run/historic-routing/frr \
	/opt/historic-routing/27f287be9/etc/frr/egpd.conf
TimeoutStartSec=150
KillMode=mixed
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

MainPID=56
ExecStart={ path=/opt/historic-routing/27f287be9/sbin/egpd ; argv[]=/opt/historic-routing/27f287be9/sbin/egpd -f /opt/historic-routing/27f287be9/etc/frr/egpd.conf -i /run/historic-routing/frr/egpd.pid -z /run/historic-routing/frr/zserv.api --vty_socket /run/historic-routing/frr -u root -g root ; ignore_errors=no ; start_time=[Fri 2026-10-30 18:10:56 UTC] ; stop_time=[n/a] ; pid=56 ; code=(null) ; status=0/0 }
ExecReload={ path=/opt/historic-routing/27f287be9/sbin/frr-reload.py ; argv[]=/opt/historic-routing/27f287be9/sbin/frr-reload.py --reload --daemon egpd --bindir /opt/historic-routing/27f287be9/bin --confdir /opt/historic-routing/27f287be9/etc/frr --logfile /run/historic-routing/frr/egpd-reload.log --rundir /run/historic-routing/frr --vty_socket /run/historic-routing/frr /opt/historic-routing/27f287be9/etc/frr/egpd.conf ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
FragmentPath=/usr/lib/systemd/system/historic-routing-egpd.service
DropInPaths=

PLATFORM peer
