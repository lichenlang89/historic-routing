[Unit]
# SPDX-License-Identifier: GPL-2.0-or-later
# historic-routing 的 EGP daemon（实验性 RFC 904 stub gateway，开发验证构建）。
# 依赖同一次构建的 historic-routing-zebra（通过 ZAPI 下发路由）。
Description=historic-routing EGP daemon (experimental, non-production)
Documentation=https://github.com/lichenlang89/historic-routing
After=network.target historic-routing-zebra.service
Wants=historic-routing-zebra.service
ConditionPathExists=@PREFIX@/sbin/egpd

[Service]
Type=simple
ExecStart=@PREFIX@/sbin/egpd \
	-f @PREFIX@/etc/frr/egpd.conf \
	-i @RUNSTATEDIR@/frr/egpd.pid \
	-z @RUNSTATEDIR@/frr/zserv.api \
	--vty_socket @RUNSTATEDIR@/frr \
	-u root -g root
ExecReload=@PREFIX@/sbin/frr-reload.py --reload --daemon egpd \
	--bindir @PREFIX@/bin --confdir @PREFIX@/etc/frr \
	--logfile @RUNSTATEDIR@/frr/egpd-reload.log \
	--rundir @RUNSTATEDIR@/frr --vty_socket @RUNSTATEDIR@/frr \
	@PREFIX@/etc/frr/egpd.conf
TimeoutStartSec=150
KillMode=mixed
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
