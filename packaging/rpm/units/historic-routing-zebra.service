[Unit]
# SPDX-License-Identifier: GPL-2.0-or-later
# historic-routing 的 zebra —— 与系统 frr.service 里的 zebra 互不兼容，不要同时运行。
# 本 unit 只负责启动，不随包启用（包里没有任何 enable/start）。
Description=historic-routing zebra (development build)
Documentation=https://github.com/lichenlang89/historic-routing
After=network.target
ConditionPathExists=@PREFIX@/sbin/zebra

[Service]
Type=simple
# socket / PID 不放安装前缀里：由 systemd 的 RuntimeDirectory 管理（与 DEB 一致），
# 停止服务即回收；编译期 runstatedir 也是 @RUNSTATEDIR@，所以 vtysh 不带参数就能连上。
RuntimeDirectory=historic-routing/frr
RuntimeDirectoryMode=0755
ExecStart=@PREFIX@/sbin/zebra \
	-f @PREFIX@/etc/frr/frr.conf \
	-i @RUNSTATEDIR@/frr/zebra.pid \
	-z @RUNSTATEDIR@/frr/zserv.api \
	--vty_socket @RUNSTATEDIR@/frr \
	-u root -g root
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=2
# 只写本项目前缀内的状态目录（/run 由 RuntimeDirectory 管理）
StateDirectory=

[Install]
WantedBy=multi-user.target
