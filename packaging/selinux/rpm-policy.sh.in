#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Manage only this package's module and paths; never modify vendor modules.
set -Eeuo pipefail
export LC_ALL=C
prefix='@PREFIX@'
run_root='@RUNSTATEDIR@'
module=historic_routing_egp
policy=/usr/share/selinux/packages/targeted/historic_routing_egp.pp.bz2
units=(historic-routing-egpd.service historic-routing-zebra.service)

fail() { echo "historic-routing SELinux: $*" >&2; exit 1; }
check_store() {
    local SELINUXTYPE=targeted
    if test -f /etc/selinux/config; then . /etc/selinux/config; fi
    test "$SELINUXTYPE" = targeted || fail 'only the targeted policy store is supported'
}
module_list() { semodule -s targeted -lfull; }
have_module() { awk '$1 == 200 && $2 == "historic_routing_egp" { found=1 } END { exit !found }' <<< "$1"; }
no_override() {
    ! awk '$1 != 200 && $2 == "historic_routing_egp" { found=1 } END { exit !found }' <<< "$1" ||
        fail 'a local module with the same name overrides priority 200; review it first'
}
relabel() {
    if selinuxenabled; then
        # Do not use fixfiles, semanage fcontext, or varrun-convert: unrelated
        # policy and administrator mappings must survive package transactions.
        test ! -d "$prefix" || restorecon -RF "$prefix"
        test ! -d "$run_root" || restorecon -RF "$run_root"
    fi
}
manager_running() { test -d /run/systemd/system; }
reload_manager() { if manager_running; then systemctl daemon-reload; fi; }
stop_units() {
    if manager_running; then
        for unit in "${units[@]}"; do
            state=$(systemctl show "$unit" -p LoadState --value)
            test "$state" != not-found || continue
            systemctl stop "$unit"
            pid=$(systemctl show "$unit" -p MainPID --value)
            state=$(systemctl show "$unit" -p ActiveState --value)
            test "$pid" = 0 || fail "$unit still has MainPID=$pid"
            case "$state" in inactive|failed) ;; *) fail "$unit remains $state";; esac
        done
    fi
}
prepare() {
    if ! selinuxenabled; then return; fi
    list=$(module_list)
    have_module "$list" || fail 'the packaged priority-200 policy module is missing'
    no_override "$list"
    # RuntimeDirectory may already exist with stale labels, or may have been
    # recreated since the RPM transaction. Prepare it before either daemon.
    relabel
    for binary in sbin/zebra sbin/egpd sbin/frr-reload.py bin/vtysh; do
        if test -e "$prefix/$binary"; then
            context=$(stat -c %C "$prefix/$binary")
            case "$context" in *:frr_exec_t:*) ;; *) fail "$binary has unexpected context $context";; esac
        fi
    done
}
check_store
case "${1:-}" in
    install)
        list=$(module_list)
        no_override "$list"
        semodule -s targeted -X 200 -i "$policy"
        relabel
        reload_manager
        ;;
    relabel) relabel ;;
    prepare) prepare ;;
    remove)
        stop_units
        list=$(module_list)
        if have_module "$list"; then semodule -s targeted -X 200 -r "$module"; fi
        relabel
        ;;
    *) fail 'expected install, relabel, prepare, or remove' ;;
esac
